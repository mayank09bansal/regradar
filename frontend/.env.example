# Frontend environment. Usually NOT needed:
#   - npm run dev           -> calls http://127.0.0.1:8000 automatically
#   - production / Vercel   -> calls the same origin (/api/...) automatically
# Only uncomment if your backend runs somewhere else. Never set this on Vercel.
# VITE_API_BASE_URL=http://127.0.0.1:8000
