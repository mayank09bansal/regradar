# =============================================================================
# RegRadar backend configuration
# Copy to .env in the project root:   Copy-Item .env.example .env
# Every variable is OPTIONAL for the deterministic demo. Full details: README.md
# Never commit .env - it is listed in .gitignore.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# SQLite (local) or PostgreSQL (e.g. Neon on Vercel: postgresql://user:pass@host/db?sslmode=require).
# Relative SQLite paths are resolved from the project root. If unset on Vercel, a temporary /tmp SQLite is used.
DATABASE_URL=sqlite:///./data/regradar.db
# Comma-separated browser origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (live mode only; demo mode never calls an LLM) ----------------------
# demo | anthropic | openai   (openai = any OpenAI-compatible API: OpenAI, Groq, Gemini, OpenRouter, Ollama)
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Anthropic (LLM_PROVIDER=anthropic) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible (LLM_PROVIDER=openai) - Groq example
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Agent behaviour ---------------------------------------------------------
# Default maximum Gap Synthesiser <-> Novelty Validator revision cycles (0-5).
MAX_REVISIONS=2

# --- Regulatory sources (live mode) - public feeds, no API key needed ----------
LIVE_SOURCES_ENABLED=true
SOURCE_TIMEOUT_SECONDS=15
RBI_RSS_URL=https://www.rbi.org.in/notifications_rss.xml
SEBI_RSS_URL=https://www.sebi.gov.in/sebirss.xml

# --- Serving the built dashboard (single-server / Vercel) -----------------------
# When frontend/dist exists, FastAPI also serves the dashboard. Set false for API-only.
SERVE_FRONTEND=true
FRONTEND_DIR=frontend/dist

# --- Optional integrations ---------------------------------------------------
# Slack incoming webhook - https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# n8n Webhook node production URL, e.g. http://localhost:5678/webhook/regradar
N8N_WEBHOOK_URL=
